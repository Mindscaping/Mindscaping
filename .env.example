# Neon PostgreSQL (create free account at neon.tech)
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=<openssl rand -hex 32>
BETTER_AUTH_URL=https://mindscaping.in

# ISR revalidation webhook (generate: openssl rand -hex 32)
REVALIDATION_SECRET=your-secret-here

# GitHub OAuth App for Decap CMS (register at github.com/settings/developers)
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret

# Analytics
NEXT_PUBLIC_GA_ID=
